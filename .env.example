# Every key the site reads. Nothing here is a real value; set them in Vercel.

# ---------------------------------------------------------------------------
# Storage. The only thing the enquiry form genuinely needs.
# ---------------------------------------------------------------------------
# Neon Postgres, the pooled connection string from the Neon dashboard. Holds the
# shared leads and rate_limit tables, one row per enquiry, tagged with
# source_domain so every site in the portfolio can share them.
# Create the tables once with:  DATABASE_URL="postgres://..." npm run migrate
# Without this the endpoint accepts nothing: a lead it cannot store is a lead
# lost, so it fails rather than pretending.
DATABASE_URL=""

# ---------------------------------------------------------------------------
# Email notification. Optional. The lead is stored either way.
# ---------------------------------------------------------------------------
# Resend API key, server-side only, never exposed to the client.
RESEND_API_KEY=""
# The verified sender on a domain you control in Resend.
LEAD_FROM_EMAIL=""
# Where enquiry notifications land. Kept in the environment rather than in
# site.config.ts because these repositories are public.
LEAD_TO_EMAIL=""

# ---------------------------------------------------------------------------
# Analytics. Client-visible by design, hence the PUBLIC_ prefix.
# ---------------------------------------------------------------------------
PUBLIC_GA_ID=""

# Cloudflare Turnstile is not used on this site. api/lead.ts opts out in so many
# words, and the honeypot, the minimum time to submit and the per-IP and
# per-email rate limits still apply.
