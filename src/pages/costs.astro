---
import Base from "../layouts/Base.astro";
import { computeCosts, DEFAULTS, CHECKED, AED } from "../lib/costs";

/* Every line the calculator can produce, shown at once with its source. The
   calculator answers "what do I pay"; this page answers "why that number". */
const all = computeCosts({ ...DEFAULTS, payingNoc: true, conveyancing: true });
const offplan = computeCosts({ ...DEFAULTS, purchase: "offplan", payingNoc: false });
---

<Base
  title="Every fee on a Dubai purchase"
  description="Each cost on a Dubai property transfer, what it is charged on, who customarily pays it, and where the figure comes from."
  path="/costs"
>
  <div class="col" style="padding-block: var(--space-l) var(--space-xl);">
    <h1>Every fee, and who pays it</h1>
    <p class="meta" style="margin-top: var(--space-s);">
      Worked at {AED.format(DEFAULTS.price)} to make the arithmetic legible.
      Checked {CHECKED}.
    </p>

    <div class="rows" style="margin-top: var(--space-l);">
      {all.lines.map((l) => (
        <div class="row">
          <span class="row-label">
            {l.label}
            <span class="row-note">{l.basis}</span>
            <span class="row-note">Source: {l.source}</span>
          </span>
          <span class="row-value">{AED.format(l.amount)}{l.estimate ? "*" : ""}</span>
        </div>
      ))}
    </div>
    <p class="meta" style="margin-top: var(--space-s);">
      * A range in practice rather than a fixed rate. The calculator uses a
      midpoint and says so.
    </p>

    <h2 style="margin-top: var(--space-xl);">What changes off-plan</h2>
    <p style="margin-top: var(--space-s);">
      Buying from a developer rather than an owner removes two lines and replaces
      a third. There is no registration trustee, because the developer registers
      the sale; the title deed becomes an Oqood registration until handover.
    </p>
    <div class="rows" style="margin-top: var(--space-s);">
      {offplan.lines.map((l) => (
        <div class="row">
          <span class="row-label">{l.label}<span class="row-note">{l.basis}</span></span>
          <span class="row-value">{AED.format(l.amount)}</span>
        </div>
      ))}
    </div>

    <h2 style="margin-top: var(--space-xl);">The parts that are negotiable</h2>
    <p style="margin-top: var(--space-s);">
      Three of these are not fixed by anyone, and buyers routinely pay them as
      though they were.
    </p>
    <div class="rows" style="margin-top: var(--space-s);">
      <div class="row">
        <span class="row-label">Agency commission
          <span class="row-note">Customary at 2%. It is a fee for a service, not a tariff.</span>
        </span>
        <span class="row-value">Negotiable</span>
      </div>
      <div class="row">
        <span class="row-label">Bank arrangement fee
          <span class="row-note">Up to 1% of the loan. Lenders discount it to win the file.</span>
        </span>
        <span class="row-value">Negotiable</span>
      </div>
      <div class="row">
        <span class="row-label">Developer no objection certificate
          <span class="row-note">Customarily the seller&rsquo;s. Who pays belongs in the contract, in writing.</span>
        </span>
        <span class="row-value">Negotiable</span>
      </div>
    </div>

    <p class="meta" style="margin-top: var(--space-xl);">
      <a href="/">Work out your own number</a>, or read
      <a href="/method">how these are calculated</a>.
    </p>
  </div>
</Base>
