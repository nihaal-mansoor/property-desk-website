---
import Base from "../layouts/Base.astro";
import config from "../../site.config";
import map from "../data/map.json";

/*
 * The map is projected and coloured at build time, so the page is a complete,
 * readable answer before any script runs. The enhancement only recolours the
 * same paths for a different metric and fills the detail panel. (§4.2)
 */
const W = 1000, H = 760, PAD = 14;

type C = (typeof map.communities)[number];
const cs = map.communities as C[];

/* Frame on the communities that actually have a market. Two thirds of Dubai's
   land area is desert interior with no residential sales, and letting it set the
   bounds shrinks the city everyone is looking for into a corner. The empty
   communities are still drawn, they just do not get a vote on the framing. */
const active = cs.filter((c) => c.psf !== null);
const lons = active.flatMap((c) => c.rings.flat().map((p) => p[0]));
const lats = active.flatMap((c) => c.rings.flat().map((p) => p[1]));
const minX = Math.min(...lons), maxX = Math.max(...lons);
const minY = Math.min(...lats), maxY = Math.max(...lats);
const cosLat = Math.cos((((minY + maxY) / 2) * Math.PI) / 180);
const scale = Math.min((W - 2 * PAD) / ((maxX - minX) * cosLat), (H - 2 * PAD) / (maxY - minY));
const px = (p: number[]) =>
  `${(PAD + (p[0] - minX) * cosLat * scale).toFixed(1)},${(H - PAD - (p[1] - minY) * scale).toFixed(1)}`;
const pathFor = (c: C) => c.rings.map((r) => `M${r.map(px).join("L")}Z`).join("");

/* Sequential: one hue, light to dark. Never a rainbow, never two hues. */
const RAMP = ["#EAF0F7", "#CBDCEC", "#A3C2DD", "#75A3CA", "#4A82B4", "#2A5F94", "#14406B", "#0B2A48"];
const NODATA = "#EDEFF2";

const priced = cs.filter((c) => c.psf !== null).map((c) => c.psf as number).sort((a, b) => a - b);
const breaks = RAMP.map((_, i) => priced[Math.floor((priced.length * i) / RAMP.length)]);
function band(v: number | null) {
  if (v === null) return NODATA;
  for (let i = RAMP.length - 1; i >= 0; i--) if (v >= breaks[i]) return RAMP[i];
  return RAMP[0];
}

const named = (c: C) =>
  c.common ?? c.name.trim().toLowerCase().replace(/\b\w/g, (w) => w.toUpperCase());
const ranked = [...cs].filter((c) => c.psf !== null).sort((a, b) => (b.psf as number) - (a.psf as number));
const fmt = new Intl.NumberFormat("en-AE");
/* The dearest community is a 22-sale island, which is a poor thing to open on.
   Default to the busiest market instead. */
const top = [...ranked].sort((a, b) => b.sales12 - a.sales12)[0];
---

<Base
  title={config.brand}
  description="Every Dubai community, coloured by what property there actually sold for. Built from 1.78 million registered Land Department transactions."
  path="/"
>
  <div class="shell" style="padding-block: var(--space-l) var(--space-xl);">
    <h1>Where the money actually goes in Dubai</h1>
    <p class="meta" style="margin-top: var(--space-s); font-size: var(--step-0); max-width: 62ch;">
      {cs.length} communities, coloured by what actually sold rather than by
      what anyone is asking. Every figure below is the registered record.
    </p>
    <p class="freshness">
      <span class="dot" aria-hidden="true"></span>
      Registered sales up to <strong>{new Date((map as any).latest).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" })}</strong>.
      Rates and shares use the last twelve months.
    </p>

    <div class="budget" role="group" aria-labelledby="budget-h">
      <p id="budget-h" class="meta" style="margin:0 0 var(--space-2xs);">
        What are you looking to spend?
      </p>
      <div class="metrics">
        <button type="button" class="metric budget-btn" data-budget="0" aria-pressed="true">Any</button>
        <button type="button" class="metric budget-btn" data-budget="1" aria-pressed="false">1m</button>
        <button type="button" class="metric budget-btn" data-budget="2" aria-pressed="false">2m</button>
        <button type="button" class="metric budget-btn" data-budget="3" aria-pressed="false">3m</button>
        <button type="button" class="metric budget-btn" data-budget="4" aria-pressed="false">5m</button>
        <button type="button" class="metric budget-btn" data-budget="5" aria-pressed="false">8m</button>
        <button type="button" class="metric budget-btn" data-budget="6" aria-pressed="false">15m</button>
      </div>
      <p class="meta" id="budget-note" style="margin-top: var(--space-2xs);">
        Pick a budget and the map shows where property at that price actually
        changed hands in the last year. Somewhere with three sales in your range
        is not a market you can buy into.
      </p>
    </div>

    <nav class="metrics" aria-label="Colour the map by" style="margin-top: var(--space-m);">
      <button type="button" class="metric" data-metric="psf" aria-pressed="true">Price per sqft</button>
      <button type="button" class="metric" data-metric="growth" aria-pressed="false">Price growth</button>
      <button type="button" class="metric" data-metric="sales12" aria-pressed="false">Sales, last 12 months</button>
      <button type="button" class="metric" data-metric="offplan" aria-pressed="false">Off-plan share</button>
      <button type="button" class="metric" data-metric="financed" aria-pressed="false">Financed share</button>
    </nav>

  </div>

  <!-- Full width, edge to edge. The map is the product; the shell would only
       shrink it. -->
  <div class="map-full">
    <div id="map" class="map-canvas" role="application"
         aria-label="Interactive map of Dubai communities. The same figures are in the table below."></div>

    <!-- Follows the cursor. Deliberately tiny: the panel is where reading
         happens, and it only changes on click. -->
    <div id="map-tip" class="map-tip" aria-hidden="true" hidden></div>

    <aside class="map-panel" aria-live="polite">
      <div class="panel-head">
        <div style="min-width:0;">
          <p class="meta" style="margin:0;" id="p-hint">Click any area on the map</p>
          <h2 id="p-name" style="font-size: var(--step-2); margin-top: var(--space-2xs);">{named(top)}</h2>
          <p class="meta" id="p-official" style="margin-top: var(--space-2xs);">{top.name}</p>
        </div>
        <button type="button" id="p-compare" class="btn btn-quiet" hidden>Compare</button>
      </div>

      <!-- Leads with the sentence a buyer could repeat to someone, not a ratio. -->
      <div id="p-budget" class="budget-answer" hidden>
        <p class="meta" style="margin:0;">At your budget, here</p>
        <p id="p-budget-line" style="margin:var(--space-2xs) 0 0; font-weight:500; font-size:var(--step-1);"></p>
        <p class="meta" id="p-budget-count" style="margin:var(--space-2xs) 0 0;"></p>
      </div>

      <!-- Liquidity next. It is what quietly ruins an off-plan investment and
           no property site shows it. -->
      <div class="rows" style="margin-top: var(--space-s);">
        <div class="row"><span class="row-label">Sales in the last year
          <span class="row-note" id="p-liquidity-note">How easily you could sell again</span></span>
          <span class="row-value" id="p-sales12">{fmt.format(top.sales12)}</span></div>
      </div>

      <section class="panel-block">
        <h3 class="panel-h">Projects trading here</h3>
        <div id="p-projects" class="rows"></div>
      </section>

      <section class="panel-block">
        <h3 class="panel-h">Latest registered sales</h3>
        <div id="p-recent" class="rows"></div>
      </section>

      <details class="panel-more">
        <summary class="meta">Market detail</summary>
        <div class="rows" style="margin-top: var(--space-2xs);">
          <div class="row"><span class="row-label">Median AED/sqft</span>
            <span class="row-value" id="p-psf">{fmt.format(top.psf as number)}</span></div>
          <div class="row"><span class="row-label">Price growth
            <span class="row-note">Today against the 2020 to 2022 average</span></span>
            <span class="row-value" id="p-growth">{top.growth !== null ? `${top.growth > 0 ? "+" : ""}${top.growth}%` : "n/a"}</span></div>
          <div class="row"><span class="row-label">Off-plan share</span>
            <span class="row-value" id="p-offplan">{top.offplan !== null ? `${top.offplan}%` : "n/a"}</span></div>
          <div class="row"><span class="row-label">Financed share
            <span class="row-note">Mortgages per 100 sales</span></span>
            <span class="row-value" id="p-financed">{top.financed !== null ? `${top.financed}%` : "n/a"}</span></div>
        </div>
      </details>
    </aside>

    <div class="map-legend">
      <div class="legend" aria-hidden="true">
        {RAMP.map((c) => <span class="swatch" style={`background:${c}`}></span>)}
      </div>
      <p class="meta" id="legend-note" style="margin:var(--space-2xs) 0 0;">
        Median AED per sqft, sales since 2023. Grey: too few sales to report.
      </p>
    </div>

    <noscript>
      <div class="map-noscript">
        <p class="meta" style="margin:0;">
          The map needs JavaScript. Every figure it shows is in the table below,
          which does not.
        </p>
      </div>
    </noscript>
  </div>

  <div class="shell">
    <!-- Compare lives here rather than on the map. Three columns of figures on
         top of a map is two things fighting for the same space. -->
    <section id="compare" class="compare" hidden>
      <div class="compare-head">
        <h2>Side by side</h2>
        <button type="button" id="compare-clear" class="btn btn-quiet">Clear</button>
      </div>
      <p class="meta" id="compare-note" style="margin-top: var(--space-2xs);">
        Add up to three areas from the map to compare them on the same figures.
      </p>
      <div style="overflow-x:auto; margin-top: var(--space-m);">
        <table id="compare-table" style="width:100%; border-collapse:collapse;"></table>
      </div>
    </section>

    <section style="margin-top: var(--space-xl);">
      <h2>Every community with enough sales to report</h2>
      <p class="meta" style="margin-top: var(--space-2xs); max-width: 62ch;">
        {ranked.length} of {cs.length}. The rest recorded fewer than 40 sales
        since 2023, which is too few to publish a median from.
      </p>
      <div style="overflow-x:auto; margin-top: var(--space-m);">
        <table style="width:100%; border-collapse:collapse; font-size: var(--step--1);">
          <thead>
            <tr>
              <th scope="col" style="text-align:left; padding:0.5rem 0.7rem 0.5rem 0; border-bottom:2px solid var(--ink);">Community</th>
              <th scope="col" style="text-align:right; padding:0.5rem 0.7rem; border-bottom:2px solid var(--ink);">AED/sqft</th>
              <th scope="col" style="text-align:right; padding:0.5rem 0.7rem; border-bottom:2px solid var(--ink);">Change</th>
              <th scope="col" style="text-align:right; padding:0.5rem 0.7rem; border-bottom:2px solid var(--ink);">Sales 12m</th>
              <th scope="col" style="text-align:right; padding:0.5rem 0 0.5rem 0.7rem; border-bottom:2px solid var(--ink);">Off-plan</th>
            </tr>
          </thead>
          <tbody>
            {ranked.map((c) => (
              <tr>
                <td style="padding:0.45rem 0.7rem 0.45rem 0; border-bottom:1px solid var(--rule);">
                  {named(c)}
                  {c.common && <span class="row-note">{c.name}</span>}
                </td>
                <td class="num" style="text-align:right; padding:0.45rem 0.7rem; border-bottom:1px solid var(--rule);">{fmt.format(c.psf as number)}</td>
                <td class="num" style="text-align:right; padding:0.45rem 0.7rem; border-bottom:1px solid var(--rule);">{c.growth !== null ? `${c.growth > 0 ? "+" : ""}${c.growth}%` : "n/a"}</td>
                <td class="num" style="text-align:right; padding:0.45rem 0.7rem; border-bottom:1px solid var(--rule);">{fmt.format(c.sales12)}</td>
                <td class="num" style="text-align:right; padding:0.45rem 0 0.45rem 0.7rem; border-bottom:1px solid var(--rule);">{c.offplan !== null ? `${c.offplan}%` : "n/a"}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <p class="meta" style="margin-top: var(--space-xl); max-width: 62ch;">
      Source: {map.source}. Names are the official cadastral ones, with the
      familiar name shown first where they differ, because nobody searches for
      Al Thanyah Fifth. How this is built is on <a href="/method">the method page</a>.
    </p>
  </div>

</Base>

<link rel="stylesheet" href="/vendor/maplibre-gl.css" />
<!-- A module file, not an inline script: the CSP carries no unsafe-inline, and
     the browser resolves MapLibre's worker relative to the vendored module. -->
<script type="module" src="/map.js"></script>
