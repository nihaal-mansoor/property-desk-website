---
import Base from "../layouts/Base.astro";
import config from "../../site.config";
import map from "../data/map.json";

/*
 * The map is projected and coloured at build time, so the page is a complete,
 * readable answer before any script runs. The enhancement only recolours the
 * same paths for a different metric and fills the detail panel. (§4.2)
 */
const W = 1000, H = 760, PAD = 14;

type C = (typeof map.communities)[number];
const cs = map.communities as C[];

/* Frame on the communities that actually have a market. Two thirds of Dubai's
   land area is desert interior with no residential sales, and letting it set the
   bounds shrinks the city everyone is looking for into a corner. The empty
   communities are still drawn, they just do not get a vote on the framing. */
/* Everything server-rendered uses the default window; the script re-colours
   for any other. */
const P0 = "12m";
const at = (c: C) => (c.periods as any)[P0];
const active = cs.filter((c) => at(c)?.psf != null);
const lons = active.flatMap((c) => c.rings.flat().map((p) => p[0]));
const lats = active.flatMap((c) => c.rings.flat().map((p) => p[1]));
const minX = Math.min(...lons), maxX = Math.max(...lons);
const minY = Math.min(...lats), maxY = Math.max(...lats);
const cosLat = Math.cos((((minY + maxY) / 2) * Math.PI) / 180);
const scale = Math.min((W - 2 * PAD) / ((maxX - minX) * cosLat), (H - 2 * PAD) / (maxY - minY));
const px = (p: number[]) =>
  `${(PAD + (p[0] - minX) * cosLat * scale).toFixed(1)},${(H - PAD - (p[1] - minY) * scale).toFixed(1)}`;
const pathFor = (c: C) => c.rings.map((r) => `M${r.map(px).join("L")}Z`).join("");

/* Sequential: one hue, light to dark. Never a rainbow, never two hues. */
const RAMP = ["#EAF0F7", "#CBDCEC", "#A3C2DD", "#75A3CA", "#4A82B4", "#2A5F94", "#14406B", "#0B2A48"];
const NODATA = "#EDEFF2";

const priced = active.map((c) => at(c).psf as number).sort((a, b) => a - b);
const breaks = RAMP.map((_, i) => priced[Math.floor((priced.length * i) / RAMP.length)]);
function band(v: number | null) {
  if (v === null) return NODATA;
  for (let i = RAMP.length - 1; i >= 0; i--) if (v >= breaks[i]) return RAMP[i];
  return RAMP[0];
}

/* Same expansion the build script applies to the geojson labels, so the table
   and the map never disagree about a community's name. */
const named = (c: C) =>
  c.common ??
  c.name.trim().toLowerCase()
    .replace(/\bind\.\s*/g, "industrial ")
    .replace(/\b\w/g, (w) => w.toUpperCase());
const ranked = [...active].sort((a, b) => at(b).psf - at(a).psf);
const fmt = new Intl.NumberFormat("en-AE");
/* The dearest community is a 22-sale island, which is a poor thing to open on.
   Default to the busiest market instead. */
const top = [...ranked].sort((a, b) => at(b).sales - at(a).sales)[0];

/* ------------------------------------------------------------------ *
 * Answers, generated from the same figures the map draws.
 *
 * Every sentence below is built from `map`, never typed. A hand-written
 * "International City is the most affordable" becomes false the first time
 * the register is refreshed, and nobody notices, because prose does not
 * fail a build. The FAQ markup and the FAQPage JSON-LD are rendered from
 * one array for the same reason: schema that disagrees with the visible
 * text on the page is a structured-data penalty, not a ranking boost.
 * ------------------------------------------------------------------ */
const sum = (map as any).summary as Record<string, any>;
const s12 = sum["12m"], s10 = sum["10y"];
const asOf = new Date((map as any).latest).toLocaleDateString("en-GB", {
  day: "numeric", month: "long", year: "numeric",
});

/* A hundred sales is the floor for a headline ranking. Below it a single
   tower or a land plot decides the answer. */
const solid = active.filter((c) => at(c).sales >= 100);
const byPsf = [...solid].sort((a, b) => at(a).psf - at(b).psf);
const dearest = [...byPsf].reverse().slice(0, 5);
const cheapest = byPsf.slice(0, 5);
const busiest = [...active].sort((a, b) => at(b).sales - at(a).sales).slice(0, 5);
const offplanTop = [...solid].sort((a, b) => at(b).offplan - at(a).offplan).slice(0, 3);
const offplanSame = offplanTop.every((c) => at(c).offplan === at(offplanTop[0]).offplan);
const offplanNames = offplanTop.map((c) => named(c)).join(", ").replace(/, ([^,]*)$/, " and $1");
const comparable = active.filter((c) => at(c).growth !== null);
const fell = comparable.filter((c) => at(c).growth < 0);
const fellNamed = [...fell].sort((a, b) => at(a).growth - at(b).growth)
  .filter((c) => at(c).sales >= 500).slice(0, 3);
const belowMedian = busiest.filter((c) => at(c).psf < s12.psf).length;
/* Ranged on the same >=100-sale floor as the rankings below. Taken across all
   95 reportable communities the span is AED 167 to 9,233, both ends set by
   markets of a few dozen sales, and it would contradict the answers further
   down the page. */
const psfSorted = solid.map((c) => at(c).psf).sort((a, b) => a - b);

/** "A at 1, B at 2 and C at 3" */
const listing = (arr: C[], value: (c: C) => string) => {
  const parts = arr.map((c) => `${named(c)} at ${value(c)}`);
  return parts.length < 2 ? parts[0] : `${parts.slice(0, -1).join(", ")} and ${parts.at(-1)}`;
};
const psfOf = (c: C) => fmt.format(at(c).psf);
const pc = (n: number) => `${n > 0 ? "+" : ""}${n} per cent`;

/* The register writes bedroom counts as "1 B/R". Spelled out for prose, and
   for the question text, which is the part a search engine matches on. */
const WORDS = ["", "one", "two", "three", "four", "five", "six", "seven"];
const roomsPhrase = (r: string) => {
  const m = /^(\d+)\s*b\/r$/i.exec(r.trim());
  return m ? `${WORDS[+m[1]] ?? m[1]}-bedroom` : r.trim().toLowerCase();
};
const t12 = s12.typical, t10 = s10.typical;
const tWord = roomsPhrase(t12.rooms);
const tNoun = /bedroom|studio/.test(tWord) ? "apartment" : "property";

const faqs: { q: string; a: string }[] = [
  {
    q: "What is the average price per square foot in Dubai?",
    a: `The median registered sale in the twelve months to ${asOf} was AED ${fmt.format(s12.psf)} per square foot, across ${fmt.format(s12.sales)} sales. Across the ${solid.length} communities with at least 100 sales, medians run from AED ${fmt.format(psfSorted[0])} to AED ${fmt.format(psfSorted.at(-1)!)}, so one city-wide number hides most of what decides a purchase. The median is used here rather than the mean because a small number of very large sales pulls an average upward.`,
  },
  {
    q: `How much does a ${tWord} ${tNoun} cost in Dubai?`,
    a: `The commonest sale on the register over the last twelve months was a ${tWord}, and its median was AED ${fmt.format(t12.price)} for about ${fmt.format(t12.sqft)} square feet, across ${fmt.format(t12.n)} sales. Over ten years the median for the same size of home was AED ${fmt.format(t10.price)}. These are medians across the whole city, and the answer moves a long way by community: the price per square foot below runs from AED ${fmt.format(psfSorted[0])} to AED ${fmt.format(psfSorted.at(-1)!)}.`,
  },
  {
    q: "Which areas of Dubai are the most expensive?",
    a: `Among communities with at least 100 registered sales in the last twelve months, the highest medians per square foot were ${listing(dearest, (c) => `AED ${psfOf(c)}`)}. These are medians for whole communities, so they cover a wide spread of buildings, ages and sizes.`,
  },
  {
    q: "Which areas of Dubai are the most affordable?",
    a: `On the same basis the lowest were ${listing(cheapest, (c) => `AED ${psfOf(c)}`)}. A low price per square foot is not the same as a low purchase price, because unit sizes differ sharply between communities.`,
  },
  {
    q: "Are Dubai property prices rising or falling?",
    a: `The city-wide median rose ${s12.growth} per cent over the twelve months to ${asOf}, measured against the twelve months immediately before. Growth was not uniform: ${fell.length} of the ${comparable.length} communities with a comparable figure fell over the same period, among them ${listing(fellNamed, (c) => pc(at(c).growth))}. Very large swings in recently launched communities usually reflect a change in what is being sold there rather than a repricing of the same stock, which is why the longer periods above are the more reliable guide.`,
  },
  {
    q: "Which Dubai communities have the most property sales?",
    a: `Over the last twelve months the busiest by registered sales were ${listing(busiest, (c) => fmt.format(at(c).sales))}. Volume and price move independently: ${["none","one","two","three","four","five"][belowMedian]} of those five sit below the city-wide median price per square foot.`,
  },
  {
    q: "How much of the Dubai property market is off-plan?",
    a: `${s12.offplan} per cent of registered sales in the last twelve months were off-plan, meaning bought from a developer before completion rather than from an existing owner. Over ten years the share is ${s10.offplan} per cent. In some communities it is close to the entire market: ${offplanSame ? `${offplanNames} each recorded ${at(offplanTop[0]).offplan} per cent` : listing(offplanTop, (c) => `${at(c).offplan} per cent`)}.`,
  },
  {
    q: "How many Dubai buyers use a mortgage?",
    a: `Mortgage registrations equalled ${s12.financed} per cent of sales over the last twelve months, and ${s10.financed} per cent over ten years. The figure is low partly because it tracks the off-plan share: a developer payment plan is not a mortgage and never reaches the mortgage register.`,
  },
  {
    q: "Why are these figures different from the ones on property portals?",
    a: `A portal shows asking prices for property currently on the market. This page shows prices registered with the Land Department after a sale completed. The two separate whenever a property sells for more or less than it was listed at, and it is the registered figure that becomes the comparable a valuer or a bank works from later.`,
  },
  {
    q: "Where does this data come from and how current is it?",
    a: `Every figure is computed from the ${(map as any).source}. The most recent sale included is dated ${asOf}, and the set covers ${fmt.format((map as any).totalSales)} residential sales. Shops, offices and land plots are excluded. A community needs at least 20 priced sales within a period before a median is published for it, which is why ${active.length} of ${cs.length} communities are reportable over twelve months and ${sum["10y"].reportable} over ten years.`,
  },
];

const schema = [
  {
    "@type": "Dataset",
    name: "Dubai residential sale prices by community",
    description: `Median registered price per square foot, price growth, sales volume, off-plan share and mortgage share for ${cs.length} Dubai communities, over four periods, computed from the Dubai Land Department transaction register.`,
    url: `https://${config.domain}/`,
    license: "https://www.dubaipulse.gov.ae/",
    isAccessibleForFree: true,
    creator: { "@id": `https://${config.domain}/#org` },
    temporalCoverage: `2015/${(map as any).latest}`,
    spatialCoverage: { "@type": "Place", name: "Dubai, United Arab Emirates" },
    variableMeasured: [
      "Median price per square foot (AED)",
      "Price growth against the preceding equal period",
      "Registered sales volume",
      "Off-plan share of sales",
      "Mortgage registrations as a share of sales",
    ],
    distribution: [
      { "@type": "DataDownload", encodingFormat: "application/geo+json", contentUrl: `https://${config.domain}/communities.geojson` },
    ],
  },
  {
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];
---

<Base
  title="Dubai property prices by area"
  description={`Median price per square foot for every Dubai community, from ${fmt.format((map as any).totalSales)} registered Land Department sales. Registered prices, not asking prices.`}
  path="/"
  schema={schema}
>
  <div class="shell" style="padding-block: var(--space-l) 0;">
    <div class="hero">
      <div>
        <h1>Dubai property prices, community by community</h1>
        <!-- The opening paragraph is the answer, not an introduction to one. It
             is the passage a search result or an assistant will quote, so it
             carries the figure, the window and the sample size in its first
             sentence. -->
        <p class="lede">
          The median Dubai home sold for <strong>AED {fmt.format(s12.psf)} per square foot</strong>{" "}
          in the twelve months to {asOf}, across {fmt.format(s12.sales)} registered sales.
          Community medians run from AED {fmt.format(psfSorted[0])} to AED {fmt.format(psfSorted.at(-1)!)}.
          These are prices registered with the Land Department after completion, not asking prices.
        </p>
      </div>

      <!-- The same four figures the paragraph beside it quotes, set where the
           width would otherwise be empty. Not a summary of the page: the
           city-wide numbers the community figures below are measured against. -->
      <dl class="hero-figs">
        {[
          { n: fmt.format(s12.psf), l: "Median AED per square foot" },
          { n: `${s12.growth > 0 ? "+" : ""}${s12.growth}%`, l: "Change on the twelve months before" },
          { n: fmt.format(s12.sales), l: "Registered sales" },
          { n: `${s12.offplan}%`, l: "Bought off-plan from a developer" },
        ].map((f) => (
          <div class="fig">
            <dt class="fig-n">{f.n}</dt>
            <dd class="fig-l">{f.l}</dd>
          </div>
        ))}
      </dl>
    </div>

    <!-- One bar, two controls, immediately above the map it drives. The copy
         that used to explain each of them lives in the labels now. -->
    <div class="filters">
      <div class="filter">
        <span class="filter-label" id="f-period">Period</span>
        <div class="filter-set" role="group" aria-labelledby="f-period">
          <button type="button" class="chip period-btn" data-period="12m" aria-pressed="true">12 months</button>
          <button type="button" class="chip period-btn" data-period="3y" aria-pressed="false">3 years</button>
          <button type="button" class="chip period-btn" data-period="5y" aria-pressed="false">5 years</button>
          <button type="button" class="chip period-btn" data-period="10y" aria-pressed="false">10 years</button>
        </div>
      </div>

      <div class="filter">
        <span class="filter-label" id="f-metric">Colour by</span>
        <div class="filter-set" role="group" aria-labelledby="f-metric">
          <button type="button" class="chip metric" data-metric="psf" aria-pressed="true">Price per sqft</button>
          <button type="button" class="chip metric" data-metric="growth" aria-pressed="false">Growth</button>
          <button type="button" class="chip metric" data-metric="sales12" aria-pressed="false">Sales volume</button>
          <button type="button" class="chip metric" data-metric="offplan" aria-pressed="false">Off-plan</button>
          <button type="button" class="chip metric" data-metric="financed" aria-pressed="false">Financed</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Full width, edge to edge. The map is the product; the shell would only
       shrink it. -->
  <div class="map-full">
    <div id="map" class="map-canvas" role="application"
         aria-label="Interactive map of Dubai communities. The same figures are in the table below."></div>

    <!-- Follows the cursor. Deliberately tiny: the panel is where reading
         happens, and it only changes on click. -->
    <div id="map-tip" class="map-tip" aria-hidden="true" hidden></div>

    <!-- Rendered hidden and revealed by the script: with no JavaScript the
         panel cannot be re-shown, so offering to hide it would be a trap. -->
    <button type="button" id="p-toggle" class="btn btn-quiet map-toggle"
            aria-expanded="true" aria-controls="map-panel" hidden>Hide panel</button>

    <aside class="map-panel" id="map-panel" aria-live="polite">
      <div class="panel-head">
        <div style="min-width:0;">
          <p class="meta" style="margin:0;" id="p-hint">Click any area on the map</p>
          <h2 id="p-name" data-id={top.id} style="font-size: var(--step-2); margin-top: var(--space-2xs);">{named(top)}</h2>
          <p class="meta" id="p-official" style="margin-top: var(--space-2xs);">{top.name}</p>
        </div>
        <button type="button" id="p-compare" class="btn btn-quiet" hidden>Compare</button>
      </div>

      <!-- Leads with the sentence a buyer could repeat to someone, not a ratio. -->
      <div id="p-typical" class="budget-answer">
        <p class="meta" style="margin:0;" id="p-typical-head">Typical sale, last 12 months</p>
        <p id="p-typical-line" style="margin:var(--space-2xs) 0 0; font-weight:500; font-size:var(--step-1);">
          {at(top).typical ? `${at(top).typical.rooms}, about ${fmt.format(at(top).typical.sqft)} sqft` : "Too few sales to say"}
        </p>
        <p class="meta" id="p-typical-price" style="margin:var(--space-2xs) 0 0;">
          {at(top).typical ? `Median ${new Intl.NumberFormat("en-AE",{style:"currency",currency:"AED",maximumFractionDigits:0,notation:"compact"}).format(at(top).typical.price)}, from ${fmt.format(at(top).typical.n)} sales` : ""}
        </p>
      </div>

      <!-- Liquidity next. It is what quietly ruins an off-plan investment and
           no property site shows it. -->
      <div class="rows" style="margin-top: var(--space-s);">
        <div class="row"><span class="row-label" id="p-sales-label">Sales in the period
          <span class="row-note" id="p-liquidity-note">How easily you could sell again</span></span>
          <span class="row-value" id="p-sales12">{fmt.format(at(top).sales)}</span></div>
      </div>

      <section class="panel-block">
        <h3 class="panel-h">Projects trading here</h3>
        <div id="p-projects" class="rows"></div>
      </section>

      <section class="panel-block">
        <h3 class="panel-h">Latest registered sales</h3>
        <div id="p-recent" class="rows"></div>
      </section>

      <details class="panel-more">
        <summary class="meta">Market detail</summary>
        <div class="rows" style="margin-top: var(--space-2xs);">
          <div class="row"><span class="row-label">Median AED/sqft</span>
            <span class="row-value" id="p-psf">{fmt.format(at(top).psf)}</span></div>
          <div class="row"><span class="row-label">Price growth
            <span class="row-note" id="p-growth-note">Against the twelve months before</span></span>
            <span class="row-value" id="p-growth">{at(top).growth !== null ? `${at(top).growth > 0 ? "+" : ""}${at(top).growth}%` : "n/a"}</span></div>
          <div class="row"><span class="row-label">Off-plan share</span>
            <span class="row-value" id="p-offplan">{at(top).offplan}%</span></div>
          <div class="row"><span class="row-label">Financed share
            <span class="row-note">Mortgages per 100 sales</span></span>
            <span class="row-value" id="p-financed">{at(top).financed}%</span></div>
        </div>
      </details>
    </aside>

    <div class="map-legend">
      <div class="legend" aria-hidden="true">
        {RAMP.map((c) => <span class="swatch" style={`background:${c}`}></span>)}
      </div>
      <p class="meta" id="legend-note" style="margin:var(--space-2xs) 0 0;">
        Median AED per sqft, sales since 2023. Grey: too few sales to report.
      </p>
    </div>

    <noscript>
      <div class="map-noscript">
        <p class="meta" style="margin:0;">
          The map needs JavaScript. Every figure it shows is in the table below,
          which does not.
        </p>
      </div>
    </noscript>
  </div>

  <div class="shell">
    <!-- Compare lives here rather than on the map. Three columns of figures on
         top of a map is two things fighting for the same space. -->
    <section id="compare" class="compare" hidden>
      <div class="compare-head">
        <h2>Side by side</h2>
        <button type="button" id="compare-clear" class="btn btn-quiet">Clear</button>
      </div>
      <p class="meta" id="compare-note" style="margin-top: var(--space-2xs);">
        Add up to three areas from the map to compare them on the same figures.
      </p>
      <div style="overflow-x:auto; margin-top: var(--space-m);">
        <table id="compare-table" style="width:100%; border-collapse:collapse;"></table>
      </div>
    </section>

    <section style="margin-top: var(--space-xl);">
      <h2>Every community with enough sales to report</h2>
      <p class="meta" style="margin-top: var(--space-2xs); max-width: 90ch;">
        {ranked.length} of {cs.length} over the last twelve months. The rest
        recorded too few sales to publish a median from. Choose a longer period
        above and more of the map fills in.
      </p>
      <div style="overflow-x:auto; margin-top: var(--space-m);">
        <table style="width:100%; border-collapse:collapse; font-size: var(--step--1);">
          <thead>
            <tr>
              <th scope="col" style="text-align:left; padding:0.5rem 0.7rem 0.5rem 0; border-bottom:2px solid var(--ink);">Community</th>
              <th scope="col" style="text-align:right; padding:0.5rem 0.7rem; border-bottom:2px solid var(--ink);">AED/sqft</th>
              <th scope="col" style="text-align:right; padding:0.5rem 0.7rem; border-bottom:2px solid var(--ink);">Change</th>
              <th scope="col" style="text-align:right; padding:0.5rem 0.7rem; border-bottom:2px solid var(--ink);">Sales 12m</th>
              <th scope="col" style="text-align:right; padding:0.5rem 0 0.5rem 0.7rem; border-bottom:2px solid var(--ink);">Off-plan</th>
            </tr>
          </thead>
          <tbody>
            {ranked.map((c) => (
              <tr>
                <td style="padding:0.45rem 0.7rem 0.45rem 0; border-bottom:1px solid var(--rule);">
                  {named(c)}
                  {c.common && <span class="row-note">{c.name}</span>}
                </td>
                <td class="num" style="text-align:right; padding:0.45rem 0.7rem; border-bottom:1px solid var(--rule);">{fmt.format(at(c).psf)}</td>
                <td class="num" style="text-align:right; padding:0.45rem 0.7rem; border-bottom:1px solid var(--rule);">{at(c).growth !== null ? `${at(c).growth > 0 ? "+" : ""}${at(c).growth}%` : "n/a"}</td>
                <td class="num" style="text-align:right; padding:0.45rem 0.7rem; border-bottom:1px solid var(--rule);">{fmt.format(at(c).sales)}</td>
                <td class="num" style="text-align:right; padding:0.45rem 0 0.45rem 0.7rem; border-bottom:1px solid var(--rule);">{at(c).offplan}%</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="qa">
      <h2>Questions this data answers</h2>
      <div class="qa-grid">
        {faqs.map((f) => (
          <div class="qa-item">
            <h3>{f.q}</h3>
            <p>{f.a}</p>
          </div>
        ))}
      </div>
    </section>

    <p class="meta" style="margin-top: var(--space-xl); max-width: 90ch;">
      Source: {(map as any).source}. Names are the official cadastral ones, with the
      familiar name shown first where they differ, because nobody searches for
      Al Thanyah Fifth. How this is built is on <a href="/method">the method page</a>.
    </p>
  </div>

</Base>

<link rel="stylesheet" href="/vendor/maplibre-gl.css" />
<!-- A module file, not an inline script: the CSP carries no unsafe-inline, and
     the browser resolves MapLibre's worker relative to the vendored module. -->
<script type="module" src="/map.js"></script>
