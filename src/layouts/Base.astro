---
import "../styles/global.css";
import { disclaimer } from "@uaeprop/site-kit";
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import config from "../../site.config";

interface Props {
  title: string;
  description: string;
  /** Path without the origin, for the canonical. */
  path: string;
  noindex?: boolean;
  /** Extra JSON-LD graph nodes for this route, beyond the Organization below. */
  schema?: readonly unknown[];
}

const { title, description, path, noindex = false, schema = [] } = Astro.props;
const canonical = new URL(path, Astro.site).href;
const ogImage = new URL(config.og.image, Astro.site).href;
/* Under 60 characters as rendered, brand suffix included. */
const fullTitle = title === config.brand ? title : `${title} · ${config.brand}`;
---

<!doctype html>
<html lang="en-AE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#FBFBFC" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0B0D10" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": `https://${config.domain}/#org`,
          name: config.brand,
          url: `https://${config.domain}`,
          description: "Independent property research for the UAE. Not a licensed broker.",
        },
        {
          "@type": "WebSite",
          "@id": `https://${config.domain}/#site`,
          name: config.brand,
          url: `https://${config.domain}`,
          publisher: { "@id": `https://${config.domain}/#org` },
        },
        {
          "@type": "WebPage",
          "@id": `${canonical}#page`,
          url: canonical,
          name: fullTitle,
          description,
          isPartOf: { "@id": `https://${config.domain}/#site` },
        },
        ...schema,
      ],
    })} />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="shell" style="padding-block: var(--space-m);">
      <nav aria-label="Main" style="display:flex; align-items:baseline; gap:var(--space-m); flex-wrap:wrap;">
        <a href="/" style="text-decoration:none; font-weight:600; letter-spacing:-0.03em; font-size:var(--step-1);">
          {config.brand}
        </a>
        <span class="meta" style="flex:1 1 auto; min-width:0;">{config.tagline}</span>
        <a href="/method" class="meta">Method</a>
      </nav>
    </header>

    <main id="main"><slot /></main>

    <footer class="shell" style="margin-top: var(--space-2xl); padding-block: var(--space-l); border-top: 1px solid var(--rule);">
      <p class="meta" style="max-width: 52ch;">{disclaimer(config.brand)}</p>
      <p class="meta" style="margin-top: var(--space-s); max-width: 62ch;">
        Contains information from the Dubai Land Department, published via Dubai
        Pulse under the UAE Federal Open Data Licence. Figures are computed by
        {config.brand} and this site is neither an official Dubai Government
        publication nor endorsed by one.
      </p>
      <p class="meta" style="margin-top: var(--space-s);">
        <a href="/privacy">Privacy</a> &middot; <a href="/terms">Terms</a> &middot; <a href="/method">Method and sources</a>
      </p>
    </footer>
    <!--
      Vercel Web Analytics. Cookieless and device-storage free, so it sits
      outside the opt-in gate that §4.6 puts around GA4 and Clarity; there is
      nothing stored on the reader's device to consent to. It ships as a
      bundled module under /_astro, never inline, and the script and beacon
      origins are already in the CSP (§4.3) via site-kit's `analytics: true`.
    -->
    <Analytics />
    <!--
      Speed Insights reports real-user Core Web Vitals, which is the only way
      to know whether the §4.1 budget holds on the phones people actually use
      rather than on an emulated profile. Same shape as Analytics above:
      cookieless, external file, and its beacon host
      vitals.vercel-insights.com is already in the CSP connect-src.
    -->
    <SpeedInsights />
  </body>
</html>
